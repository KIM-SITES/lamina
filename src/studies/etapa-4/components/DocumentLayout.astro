---
interface Props { title: string; description: string; }
const { title, description } = Astro.props;
---
<!doctype html><html lang="pt-BR"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><meta name="robots" content="noindex,nofollow" /><meta name="description" content={description} /><meta name="theme-color" content="#083c63" /><title>{title}</title><link rel="icon" href="/favicon.svg" type="image/svg+xml" /></head><body class="document"><a class="document-skip" href="#documento">Pular para o relatório</a><header><nav aria-label="Documentação da Etapa 4"><a href="/estudos/etapa-4/revisao/">Comparação, prints e vídeos</a><a href="/estudos/etapa-4/diagnostico/">Diagnóstico inicial</a><a href="/estudos/etapa-4/relatorio/">Relatório final</a><a href="/estudos/etapa-4/">Versão refinada</a></nav></header><main id="documento"><slot /></main></body></html>
<style is:global>
  .document *{box-sizing:border-box}.document{margin:0;background:#e9f9e7;color:#083c63;font:16px/1.7 system-ui,sans-serif}.document header,.document main{max-width:1400px;margin:auto;padding:30px clamp(20px,4vw,60px)}.document nav{display:flex;flex-wrap:wrap;gap:12px 28px}.document a{color:inherit;text-underline-offset:5px}.document a:focus-visible{outline:3px solid #1658ba;outline-offset:4px}.document header a{min-height:44px;display:inline-flex;align-items:center}.document h1,.document h2{line-height:1.15;font-weight:500;letter-spacing:-.035em}.document h1{font-size:clamp(36px,5vw,68px)}.document h2{font-size:30px;margin-top:44px}.document p,.document li{max-width:950px}.document table{border-collapse:collapse;width:100%;font-size:14px}.document th,.document td{border:1px solid #9abdb9;text-align:left;vertical-align:top;padding:14px}.document code{overflow-wrap:anywhere}.document-skip{position:fixed;top:12px;left:12px;transform:translateY(-200%);background:#f6d567;padding:14px;z-index:10}.document-skip:focus{transform:none}@media(max-width:699px){.document table{font-size:12px;display:block;overflow:auto;max-width:100%}.document th,.document td{padding:8px}.document main{overflow-wrap:anywhere}}
</style>
