---
import Photo from './Photo.astro';
---
<section class="hero" id="inicio" aria-labelledby="titulo">
  <Photo class="hero-photo" eager alt="Cena ilustrativa de piscina verde mineral diante de pavilhão de concreto e madeira, com borda de pedra clara e árvore de jasmim-manga." />
  <div class="hero-shade" aria-hidden="true"></div>
  <header class="header wrap">
    <a class="brand" href="#inicio" aria-label="Lâmina — Piscinas e Paisagens, início" translate="no">lâmina<span>.</span></a>
    <nav aria-label="Navegação principal"><a href="#servicos">Serviços</a><a href="#ambientes">Ambientes</a><a class="header-action" href="#orcamento">Simular orçamento <span aria-hidden="true">↗</span></a></nav>
  </header>
  <div class="hero-context wrap"><p>Piscinas &amp; Paisagens</p><p>Projeto demonstrativo</p></div>
  <div class="hero-composition wrap">
    <h1 id="titulo" tabindex="-1"><span class="title-pool">Piscinas,</span><span class="title-landscape">entre luz e paisagem.</span></h1>
    <div class="hero-bottom"><p>Projeto, construção, revitalização<br class="wide-break" /> e manutenção de piscinas.</p><div class="hero-actions"><a class="underlink" href="#ambientes">Conhecer os ambientes</a><a class="button button-light" href="#orcamento">Simular orçamento <span aria-hidden="true">↗</span></a></div></div>
  </div>
</section>
