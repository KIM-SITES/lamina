---
import type { services } from '../../data/content';
interface Props { service: typeof services[number]; primary?: boolean }
const { service, primary=false } = Astro.props;
const descriptions = {
  projeto: 'Arquitetura, materiais e execução para a piscina que você imagina.',
  revitalizacao: 'Novos revestimentos, bordas e sistemas para a piscina que já existe.',
  manutencao: 'Água e equipamentos bem cuidados, em todas as estações.',
};
const actions = { projeto:'Simular projeto e construção', revitalizacao:'Simular revitalização', manutencao:'Simular manutenção' };
---
<article class:list={['service',`service-${service.id}`,{'service-primary':primary}]} aria-labelledby={`service-${service.id}`}>
  <h3 id={`service-${service.id}`}>{service.title}</h3>
  <div class="service-detail"><p>{descriptions[service.id]}</p><a tabindex="0" data-select-service={service.id} href="#orcamento">{actions[service.id]} <span aria-hidden="true">↗</span></a></div>
  <slot />
</article>
