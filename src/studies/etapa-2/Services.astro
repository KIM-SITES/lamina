---
import { services } from '../../data/content';

const descriptions = {
  projeto: 'Arquitetura, materiais e execução para a piscina que você imagina.',
  revitalizacao: 'Novos revestimentos, bordas e sistemas para a piscina que já existe.',
  manutencao: 'Água e equipamentos bem cuidados, em todas as estações.',
};
const actions = {
  projeto: 'Simular projeto e construção',
  revitalizacao: 'Simular revitalização',
  manutencao: 'Simular manutenção',
};
---
<section class="services" id="servicos" aria-labelledby="services-title">
  <div class="services-stage">
    <header class="services-heading shell">
      <h2 id="services-title" tabindex="-1"><span>Da paisagem</span><span>ao detalhe.</span></h2>
    </header>
    <figure class="services-media" data-destination>
      <picture>
        <source media="(max-width:699px), (max-width:1099px) and (orientation:portrait)" srcset="/studies/etapa-2/superficie-vertical.webp" width="1024" height="1536" />
        <img src="/studies/etapa-1/superficie-desktop.webp" width="1586" height="992" alt="A mesma piscina da abertura, com borda de pedra, água verde e pavilhão integrados ao jardim." loading="lazy" decoding="async" />
      </picture>
    </figure>
    <div class="services-bridge shell"><p>Uma piscina começa no espaço.<br />E continua no cuidado.</p><a tabindex="0" href="#services-offer">Conheça os serviços <span aria-hidden="true">↓</span></a></div>
  </div>
  <div class="services-offer shell" id="services-offer">
    {services.map(service => <article class={`service service-${service.id}`} aria-labelledby={`service-${service.id}`}>
      <h3 id={`service-${service.id}`}>{service.title}</h3>
      <div class="service-detail"><p>{descriptions[service.id]}</p><a tabindex="0" data-select-service={service.id} href="#orcamento">{actions[service.id]} <span aria-hidden="true">↗</span></a></div>
    </article>)}
  </div>
</section>
