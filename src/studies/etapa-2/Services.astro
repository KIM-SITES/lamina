---
import { services } from '../../data/content';
import ServiceEntry from './ServiceEntry.astro';
const [project,renewal,care]=services;
---
<section class="services" id="servicos" aria-labelledby="services-title">
  <div class="services-stage">
    <header class="services-heading">
      <h2 id="services-title" tabindex="-1"><span>Da paisagem</span><span>ao detalhe.</span></h2>
      <p>Do primeiro traço<br />ao cuidado com a água.</p>
      <nav class="services-bridge" aria-label="Atalhos dos serviços"><a tabindex="0" href="#services-offer">Renovar ou cuidar <span aria-hidden="true">↓</span></a></nav>
    </header>
    <figure class="services-media" data-destination>
      <picture>
        <source media="(max-width:699px), (max-width:1099px) and (orientation:portrait)" srcset="/studies/etapa-2/superficie-vertical.webp" width="1024" height="1536" />
        <img src="/studies/etapa-1/superficie-desktop.webp" width="1586" height="992" alt="A mesma piscina da abertura, com borda de pedra, água verde e pavilhão integrados ao jardim." loading="lazy" decoding="async" />
      </picture>
    </figure>
    <div class="services-project"><ServiceEntry service={project} primary /></div>
  </div>
  <div class="services-offer shell" id="services-offer">
    <ServiceEntry service={renewal}><figure class="material-detail" aria-hidden="true"><img src="/studies/etapa-1/superficie-desktop.webp" alt="" width="1586" height="992" loading="lazy" decoding="async" /></figure></ServiceEntry>
    <ServiceEntry service={care} />
  </div>
</section>
